# Copy this file to .env and replace every placeholder with your own credentials.
# Never commit .env or share its secrets in chat.
API_ID=12345678
API_HASH=replace_with_your_api_hash
BOT_TOKEN=1234567890:replace_with_your_bot_token
ADMIN_IDS=123456789

PLATFORM_NAME=Onyx Session Manager
CHANNEL_LINK=
SUPPORT_LINK=

# Heroku supplies PORT automatically. Keep SERVER_PORT only for local hosting.
# PORT=8080
# SERVER_PORT=8080

MAX_CONCURRENCY=2
GLOBAL_MAX_CONNECTIONS=25
CONNECT_TIMEOUT=20
SKIP_SPAMBOT=False
USE_IPV6=False

# Optional proxy settings; leave blank if not using a proxy.
PROXY_TYPE=none
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
PROXY_FILE=proxies.txt
PROXY_LIST=
PROXY_ROTATION_ENABLED=true

# Optional dedicated proxy for FloodWait failover; never used to bypass Telegram account limits.
FLOODWAIT_PROXY_HOST=
FLOODWAIT_PROXY_PORT=443
FLOODWAIT_PROXY_USER=
FLOODWAIT_PROXY_PASS=

MAX_ARCHIVE_MEMBERS=10000
MAX_ARCHIVE_MEMBER_BYTES=134217728
MAX_ARCHIVE_EXPANDED_BYTES=536870912
